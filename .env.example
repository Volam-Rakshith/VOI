# ---------------------------------------------------------------------------
# IMPOSTER — environment variables (optional)
# ---------------------------------------------------------------------------
# Local pass & play mode, the Black Box word engine and all settings work with
# ZERO configuration — they are fully offline and use LocalStorage.
#
# The ONLINE ROOM mode needs a free Supabase project. Copy this file to `.env`
# and fill in the two public values from
#   Supabase Dashboard -> Project Settings -> API
#
# These are PUBLIC client values and are safe to ship in a static bundle.
# NEVER put the `service_role` key (or any secret) in a Vite env variable —
# everything prefixed with VITE_ ends up in the shipped JavaScript.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: rooms auto-expire after this many idle minutes (default 180).
VITE_ROOM_TTL_MINUTES=180

# Optional: absolute asset base path. Default is './' (relative) which works
# for both https://user.github.io/repo/ and https://user.github.io/ .
# VITE_BASE_PATH=/repository-name/
